{
  "name": "ultrachess",
  "version": "1.3.0",
  "description": "Ultra-fast WASM-first chess library (Rust core + TypeScript shim).",
  "type": "module",
  "license": "MIT",
  "author": "Yahor Barkouski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahorbarkouski/ultrachess.git"
  },
  "bugs": {
    "url": "https://github.com/yahorbarkouski/ultrachess/issues"
  },
  "homepage": "https://github.com/yahorbarkouski/ultrachess#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "files": [
    "dist",
    "assets/ultrachess.wasm",
    "README.md",
    "COMPAT.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./inline": {
      "import": {
        "types": "./dist/inline.d.ts",
        "default": "./dist/inline.js"
      },
      "require": {
        "types": "./dist/inline.d.cts",
        "default": "./dist/inline.cjs"
      }
    },
    "./low-level": {
      "import": {
        "types": "./dist/low-level.d.ts",
        "default": "./dist/low-level.js"
      },
      "require": {
        "types": "./dist/low-level.d.cts",
        "default": "./dist/low-level.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown -p ultrachess-wasm && mkdir -p assets && cp target/wasm32-unknown-unknown/release/ultrachess_wasm.wasm assets/ultrachess.wasm && node scripts/wasm-opt.mjs",
    "build:inline": "node scripts/generate-inline.mjs",
    "build:ts": "tsup",
    "build": "npm run build:wasm && npm run build:inline && npm run build:ts",
    "test:rust": "cargo test --release -p ultrachess-core",
    "test:rust:deep": "cargo test --release -p ultrachess-core --test perft -- --ignored",
    "test:ts": "npm run build:wasm && npm run build:inline && vitest run",
    "test": "npm run test:rust && npm run test:ts",
    "coverage:ts": "vitest run --coverage",
    "coverage:rs": "cargo llvm-cov -p ultrachess-core --summary-only",
    "coverage": "npm run coverage:rs && npm run build:wasm && npm run build:inline && npm run coverage:ts",
    "typecheck": "tsc --noEmit",
    "fmt": "cargo fmt --all && biome format --write .",
    "fmt:check": "cargo fmt --all --check && biome format .",
    "lint": "cargo clippy --all-targets --workspace -- -D warnings && biome lint .",
    "check": "npm run fmt:check && npm run lint && npm run typecheck",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "chess.js": "^1.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "chess",
    "wasm",
    "webassembly",
    "perft",
    "fen",
    "pgn",
    "san",
    "zobrist",
    "chess.js"
  ]
}
